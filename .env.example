# Sunucu
PORT=3000
NODE_ENV=production

# Oturum ve kod imzalama icin rastgele, uzun bir metin girin (orn. `openssl rand -hex 32`)
SESSION_SECRET=degistirin-bu-cok-gizli-bir-anahtar-olmali

# Admin panel (/admin) sifresi - kayitlari gormek icin
ADMIN_SIFRE=degistirin-guclu-bir-admin-sifresi

# Admin panelinde kullanici sifrelerini goruntuleyebilmek icin (geri dondurulebilir
# sifreleme, AES-256-GCM). 64 karakterlik hex bir deger olmali. Uretmek icin:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# UYARI: Bu anahtar + veritabani ele gecirirse kullanici sifreleri acilabilir.
ENCRYPTION_KEY=degistirin-64-karakterlik-hex-bir-anahtar-olmali

# Dogrulama kodu e-posta ile gonderilecekse SMTP bilgileri (opsiyonel).
# Bos birakilirsa kod, sunucu logunda ve (sadece NODE_ENV=development iken)
# API yanitinda gosterilir; boylece SMTP kurmadan da test edebilirsiniz.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Odul Kampanyasi <odul@example.com>"
